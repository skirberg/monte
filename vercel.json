{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self' https://samikirberg.com"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/study/learn/topics/:topic/:lesson",
      "destination": "/learn/:topic/:lesson/",
      "permanent": true
    },
    {
      "source": "/study/learn/topics/:topic/:lesson/",
      "destination": "/learn/:topic/:lesson/",
      "permanent": true
    },
    {
      "source": "/study/learn/topics/:topic",
      "destination": "/learn/:topic/",
      "permanent": true
    },
    {
      "source": "/study/learn/topics/:topic/",
      "destination": "/learn/:topic/",
      "permanent": true
    },
    {
      "source": "/study/learn/topics",
      "destination": "/learn/",
      "permanent": true
    },
    {
      "source": "/study/learn/topics/",
      "destination": "/learn/",
      "permanent": true
    },
    {
      "source": "/study/learn",
      "destination": "/learn/",
      "permanent": true
    },
    {
      "source": "/study/learn/",
      "destination": "/learn/",
      "permanent": true
    },
    {
      "source": "/study/learn/:path+",
      "destination": "/learn/:path+/",
      "permanent": true
    },
    {
      "source": "/study/learn/:path+/",
      "destination": "/learn/:path+/",
      "permanent": true
    },
    {
      "source": "/study/practice/:path*",
      "destination": "/practice/:path*",
      "permanent": true
    },
    {
      "source": "/study/solve/:path*",
      "destination": "/solve/:path*",
      "permanent": true
    },
    {
      "source": "/study/tools/:path*",
      "destination": "/tools/:path*",
      "permanent": true
    },
    {
      "source": "/study/sources",
      "destination": "/sources/",
      "permanent": true
    },
    {
      "source": "/study/sources/",
      "destination": "/sources/",
      "permanent": true
    }
  ]
}
