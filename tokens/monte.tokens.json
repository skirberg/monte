      },
      "$description": "Clay, the crushed brick of the court: the colour of the number. Same naming as warm."
    },
    "red": {
      "440": {
        "$value": { "colorSpace": "oklch", "components": [0.44, 0.17, 22], "hex": "#9b0d23" }
      },
      "500": {
        "$value": { "colorSpace": "oklch", "components": [0.5, 0.19, 22], "hex": "#b7162d" }
      },
      "780": {
        "$value": { "colorSpace": "oklch", "components": [0.78, 0.13, 22], "hex": "#ff9492" }
      },
      "840": {
        "$value": { "colorSpace": "oklch", "components": [0.84, 0.1, 22], "hex": "#ffb1ad" }
      },
      "$description": "A wrong answer. Never a joke."
    }
  },
  "mode": {
    "$description": "The semantic layer, one group per mode. A token's name is its CSS custom property (--paper, --ink-muted). Each token points at a primitive, or at a token of its own mode. A mode that $extends another inherits its tokens and overrides only what it lists; inherited references to the parent mode point at the child.",
    "light": {
      "$description": "The day court. :root",
      "$extensions": { "markets.monte": { "selector": ":root" } },
      "$type": "color",
      "surface": {
        "paper": {
          "$value": "{color.warm.975}",
          "$description": "The page."
        },
        "sand": {
          "$value": "{color.warm.945}",
          "$description": "Quiet surfaces and stages."
        },
        "sand-2": {
          "$value": "{color.warm.915}",
          "$description": "A step deeper than sand: pressed and hovered surfaces."
        }
      },
      "text": {
        "ink": {
          "$value": "{color.warm.200}",
          "$description": "Words."
        },
        "ink-muted": {
          "$value": "{color.warm.470}",
          "$description": "Secondary text."
        }
      },
      "action": {
        "btn": {
          "$value": "{color.warm.290}",
          "$description": "The main button: ink means the action."
        },
        "btn-hover": {
          "$value": "{color.warm.350}"
        },
        "ink-lip": {
          "$value": "{color.warm.100}",
          "$description": "The 3 px edge a main button stands on."
        }
      },
      "border": {
        "line": {
          "$value": "{color.warm.870}",
          "$description": "Hairlines."
        },
        "line-strong": {
          "$value": "{color.warm.620}",
          "$description": "Control borders, the pegs on the board."
        }
      },
      "data": {
        "clay": {
          "$value": "{color.clay.600}",
          "$description": "The number: curves, bars, answers, the mark."
        },
        "clay-ink": {
          "$value": "{color.clay.500}",
          "$description": "Clay as small text."
        },
        "clay-tint": {
          "$value": "{color.clay.935}",
          "$description": "The clay highlight behind a chosen answer."
        }
      },
      "state": {
        "success": {
          "$value": "{mode.light.data.clay-ink}",
          "$description": "A right answer is clay, the won colour: there is no green."
        },
        "danger": {
          "$value": "{color.red.500}",
          "$description": "A wrong answer."
        }
      }
    },
    "dark": {
      "$description": "The night session. .dark",
      "$extensions": { "markets.monte": { "selector": ".dark", "colorScheme": "dark" } },
      "$type": "color",
      "surface": {
        "paper": {
          "$value": "{color.warm.170}"
        },
        "sand": {
          "$value": "{color.warm.215}"
        },
        "sand-2": {
          "$value": "{color.warm.255}"
        }
      },
      "text": {
        "ink": {
          "$value": "{color.warm.950}"
        },
        "ink-muted": {
          "$value": "{color.warm.780}"
        }
      },
      "action": {
        "btn": {
          "$value": "{mode.dark.text.ink}"
        },
        "btn-hover": {
          "$value": "{color.warm.880}"
        },
        "ink-lip": {
          "$value": "{color.warm.640}"
        }
      },
      "border": {
        "line": {
          "$value": "{color.warm.320}"
        },
        "line-strong": {
          "$value": "{color.warm.500}"
        }
      },
      "data": {
        "clay": {
          "$value": "{color.clay.720}"
        },
        "clay-ink": {
          "$value": "{color.clay.780}"
        },
        "clay-tint": {
          "$value": "{color.clay.290}"
        }
      },
      "state": {
        "success": {
          "$value": "{mode.dark.data.clay-ink}"
        },
        "danger": {
          "$value": "{color.red.780}"
        }
      }
    },
    "light-hc": {
      "$description": "The day court for people who ask for more contrast (prefers-contrast: more): darker secondary text, lines you can see, deeper clay.",
      "$extensions": { "markets.monte": { "selector": ":root:not(.dark)", "media": "(prefers-contrast: more)" } },
      "$extends": "{mode.light}",
      "text": {
        "ink-muted": {
          "$value": "{color.warm.380}"
        }
      },
      "border": {
        "line": {
          "$value": "{color.warm.620}"
        },
        "line-strong": {
          "$value": "{color.warm.450}"
        }
      },
      "data": {
        "clay": {
          "$value": "{color.clay.540}"
        },
        "clay-ink": {
          "$value": "{color.clay.430}"
        }
      },
      "state": {
        "danger": {
          "$value": "{color.red.440}"
        }
      }
    },
    "dark-hc": {
      "$description": "The night session with more contrast (prefers-contrast: more).",
      "$extensions": { "markets.monte": { "selector": ".dark", "media": "(prefers-contrast: more)" } },
      "$extends": "{mode.dark}",
      "text": {
        "ink": {
          "$value": "{color.warm.985}"
        },
        "ink-muted": {
          "$value": "{color.warm.860}"
        }
      },
      "border": {
        "line": {
          "$value": "{color.warm.500}"
        },
        "line-strong": {
          "$value": "{color.warm.680}"
        }
      },
      "data": {
        "clay": {
          "$value": "{color.clay.760}"
        },
        "clay-ink": {
          "$value": "{color.clay.850}"
        }
      },
      "state": {
        "danger": {
          "$value": "{color.red.840}"
        }
      }
    }
  },
  "radius": {
    "$type": "dimension",
    "$description": "Three corners for surfaces (DESIGN.md, Shape). Controls are pills.",
    "inner": {
      "$value": { "value": 0.875, "unit": "rem" },
      "$description": "A tile or an answer inside a card."
    },
    "card": {
      "$value": { "value": 1.5, "unit": "rem" },
      "$description": "Every card, panel and sheet."
    },
    "stage": {
      "$value": { "value": 1.75, "unit": "rem" },
      "$description": "The stage under a chart, a board or a game."
    }
  },
  "motion": {
    "duration": {
      "$type": "duration",
      "press": {
        "$value": { "value": 90, "unit": "ms" },
        "$description": "A button or answer sinking onto its edge."
      },
      "tap": {
        "$value": { "value": 120, "unit": "ms" },
        "$description": "Anything else pressed: it settles to 97%."
      },
      "ui": {
        "$value": { "value": 150, "unit": "ms" },
        "$description": "Colour and border fades."
      },
      "enter": {
        "$value": { "value": 240, "unit": "ms" },
        "$description": "Something arriving."
      },
      "move": {
        "$value": { "value": 400, "unit": "ms" },
        "$description": "A mark travelling to its page (view transitions)."
      }
    },
    "ease": {
      "$type": "cubicBezier",
      "settle": {
        "$value": [0.2, 0.8, 0.2, 1],
        "$description": "Settle: fast out, slow into place, like a grain landing."
      }
    }
  }
}
