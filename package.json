{
  "name": "monte",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "prebuild": "tsx scripts/fetch-drawit.ts && (tsx scripts/make-brand.tsx --if-stale || true) && (tsx scripts/make-cheatsheets.tsx || true) && (tsx scripts/make-api.ts || true)",
    "build": "next build",
    "drawit": "tsx scripts/fetch-drawit.ts",
    "cheatsheets": "tsx scripts/make-cheatsheets.tsx",
    "api": "tsx scripts/make-api.ts",
    "tokens": "tsx scripts/make-tokens.ts",
    "tokens:check": "tsx scripts/make-tokens.ts --check",
    "brand": "tsx scripts/make-brand.tsx",
    "brand:check": "tsx scripts/make-brand.tsx --check",
    "brand:live": "node scripts/check-kit.ts https://monte.markets",
    "start": "next start",
    "lint": "eslint .",
    "smoke": "tsx scripts/smoke.ts",
    "contrast": "tsx scripts/contrast.ts",
    "qa": "tsx scripts/qa.ts",
    "shots": "tsx scripts/shots.ts",
    "test": "vitest run",
    "check": "npm test && npm run typecheck && npm run lint && npm run tokens:check && npm run scale-check && npm run brand:check && next build && npm run contrast && npm run qa && npm run smoke",
    "typecheck": "tsc --noEmit && tsc --noEmit -p mcp",
    "scale-check": "tsx scripts/scale-check.ts",
    "check-sources": "tsx scripts/check-sources.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.1.0",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.2",
    "lucide-react": "^1.75.0",
    "motion": "^14.14.0",
    "next": "^16.4.6",
    "next-themes": "^0.4.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "ts-fsrs": "^6.0.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "axe-core": "^4.14.1",
    "eslint": "^10.15.0",
    "eslint-config-next": "^16.4.6",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.1.1"
  }
}
